# ==============================================================================
# SCENTIVA Backend — Environment Variables Template (Spring Boot 3.3.4 & Java 21)
# Copy to backend/.env for local development, or configure in Render Web Service Environment
# ==============================================================================

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SERVER_PORT=8080
APP_BASE_URL=https://scentiva-backend.onrender.com
FRONTEND_URL=https://scentiva.vercel.app

# PostgreSQL Database Connection (Render Managed DB / Localhost / Cloud DB)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scentiva_db
SPRING_DATASOURCE_USERNAME=scentiva_user
SPRING_DATASOURCE_PASSWORD=scentiva_secret_password_2026

# HikariCP Connection Pool Optimization
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Security & JWT Token Provider (HMAC SHA-512 Signature — Minimum 64 characters / 512 bits)
JWT_SECRET=scentiva-master-secret-key-2026-luxury-perfumery-enterprise-jwt-token-key-minimum-512-bits-long-signature
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Optional Payment & Logistics Provider Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
