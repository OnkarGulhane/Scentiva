# ==============================================================================
# SCENTIVA Frontend — Environment Variables Template (Next.js 14)
# Copy to .env.local for local development, or configure in Vercel Project Settings
# ==============================================================================

# Backend Spring Boot REST API Endpoint (Must include /api/v1)
# Local Development: http://localhost:8080/api/v1
# Production (Render): https://scentiva-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Public Website Canonical URL
# Local Development: http://localhost:3000
# Production (Vercel): https://scentiva.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
