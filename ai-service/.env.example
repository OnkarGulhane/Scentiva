# SCENTIVA AI Service Environment Configuration (Example Placeholders)
# Copy to .env for local overrides - NEVER commit live credentials

# Service Ports & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Spring Boot Monolith Gateway
SPRING_BOOT_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL & pgvector Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scentiva
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scentiva_vectors

# LLM Configuration (Configurable Providers: openai, anthropic, gemini, ollama, mock)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_placeholder
LLM_TEMPERATURE=0.2

# Embedding Configuration (Configurable Providers: openai, local, mock)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_openai_api_key_placeholder

# Security & Guardrails
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_LENGTH=1000
MAX_TOOL_ITERATIONS=5
JWT_SECRET=scentiva-master-secret-key-2026-luxury-perfumery-enterprise-jwt-token-key-minimum-512-bits-long-signature
